# Alert delivery and dead-man heartbeat for the UTXORef V2 watchtower.
# Installed as /etc/utxoref-v2-watchtower-alerts.env, root-only (0600): systemd
# reads it before dropping privileges, so an inline API key stays root-only.
# The bridge script rewrites /etc/utxoref-v2-watchtower.env (RPC credentials)
# on every start and never touches this file.

# Name used in alert subjects.
#UTXOREF_WATCHTOWER_ID=vps-watchtower-1

# Email through a provider HTTP API: postmark, resend, sendgrid or mailgun.
#UTXOREF_ALERT_EMAIL_PROVIDER=postmark
#UTXOREF_ALERT_EMAIL_API_KEY=replace-with-provider-api-key
# Or a key file, which must be readable by the utxoref service user:
#UTXOREF_ALERT_EMAIL_API_KEY_FILE=/etc/utxoref-v2-watchtower-email.key
#UTXOREF_ALERT_EMAIL_FROM=watchtower@example.org
#UTXOREF_ALERT_EMAIL_TO=ops@example.org,oncall@example.org
# Mailgun only:
#UTXOREF_ALERT_MAILGUN_DOMAIN=mg.example.org
#UTXOREF_ALERT_MAILGUN_API_BASE=https://api.mailgun.net

# Webhook: generic (JSON), slack, discord or ntfy.
#UTXOREF_ALERT_WEBHOOK_URL=https://ntfy.sh/replace-with-a-private-topic
#UTXOREF_ALERT_WEBHOOK_FORMAT=ntfy

# Dead-man heartbeat: fetched after every healthy tick. Point it at a push or
# heartbeat monitor (healthchecks.io, Better Stack, Uptime Kuma push) that
# alerts when the pings stop.
#UTXOREF_WATCHTOWER_HEARTBEAT_URL=https://hc-ping.com/replace-with-check-uuid

# Policy (defaults shown).
#UTXOREF_ALERT_MIN_SEVERITY=info
#UTXOREF_ALERT_REPEAT_CRITICAL_SECONDS=1800
#UTXOREF_ALERT_FAILURE_THRESHOLD=3
#UTXOREF_ALERT_MAX_PER_HOUR=20
