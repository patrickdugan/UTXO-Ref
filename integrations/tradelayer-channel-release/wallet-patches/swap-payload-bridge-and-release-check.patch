         throw new Error(`listener does not enforce trade expiry: ${res.error || 'capability missing'}`);
     }
+    // The listener's channel rules count only when the chain activated them for its own release.
+    const codeHash = res.data?.codeHash;
+    const ok = typeof codeHash === 'string' && /^[0-9a-f]{64}$/.test(codeHash)
+        && [3, 4].every((type) => res.data?.recorded?.[type]?.rulesActive === true && res.data.recorded[type].codeHash === codeHash);
+    if (!ok) throw new Error(`listener release is not the one activated for channel trades`);
