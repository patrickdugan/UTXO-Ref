--- /dev/null
+++ b/tests/support/listener-stub.js
@@ -0,0 +1,13 @@
+'use strict';
+
+// Listener answers for the protocol checks the swappers make before a commit or a payment
+// (wallet-fe utils/swapper/trade-payload.ts): the trade-expiry capability and the channel column.
+const CAPABILITIES = { tradeTokenForUTXO: { maxParts: 9, expiryBlock: true }, channelColumn: { version: 2 } };
+
+const listenerReply = (method) => {
+    if (method === 'tl_getProtocolCapabilities') return { data: CAPABILITIES };
+    if (method === 'tl_getChannelColumn') return { data: { column: 'A', columnA: true } };
+    return null;
+};
+
+module.exports = { CAPABILITIES, listenerReply };
