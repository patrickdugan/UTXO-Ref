+const { CAPABILITIES } = require('../support/listener-stub');
+
+const proxy = () => loadTs(path.join(REPO, 'packages/wallet-server/src/services/rpc-proxy.service.ts'), {
+    '../index': { fasitfyServer: {} }, './node.service': {},
+}).exports;
+const tradePayload = () => loadTs(path.join(REPO, 'packages/wallet-fe/src/app/utils/swapper/trade-payload.ts')).exports;
+
+// A P2WSH channel address is longer than 42 characters, so the commit names it as output 0 (ref:0).
+const CHANNEL = 'tb1q' + 'q'.repeat(58);
+const units = (n) => Math.round(n * 1e8).toString(36);
+// The candidate consensus decoder, when the sibling checkout is present.
+const CANDIDATE = path.resolve(REPO, '../redteam-tradelayer-channel/src/txDecoder.js');
+
+test('channel commit: positional property, amount and the negotiated channel address, in a data envelope', async () => {
+    const { proxyWalletMethod } = proxy();
+    assert.deepEqual(await proxyWalletMethod('tl_createpayload_commit_tochannel', { params: [1, '1', CHANNEL] }),
+        { data: `tl41,${units(1)},ref:0,0,,0` });
+    assert.deepEqual(await proxyWalletMethod('tl_createpayload_commit_tochannel', { params: [5, 0.5, 'shortaddr'] }),
+        { data: `tl45,${units(0.5)},shortaddr,0,,0` });
+});
+
+test('channel commit without a channel address, property or amount is an error', async () => {
+    const { proxyWalletMethod } = proxy();
+    for (const params of [[1, '1'], [0, '1', CHANNEL], [1, 0, CHANNEL], [1, 'x', CHANNEL]]) {
+        const res = await proxyWalletMethod('tl_createpayload_commit_tochannel', { params });
+        assert.ok(res.error && res.data === undefined, JSON.stringify(params));
+    }
+});
+
+test('native trade: positional fields become the nine-part payload with column, output indices and expiry', async () => {
+    const { proxyWalletMethod } = proxy();
+    const res = await proxyWalletMethod('tl_createpayload_instant_ltc_trade', { params: [1, '1', '0.01', 200000, true, 0, 1] });
+    assert.deepEqual(res, { data: `tl31,${units(1)},1,${units(0.01)},0,1,0,,${(200000).toString(36)}` });
+    const columnB = await proxyWalletMethod('tl_createpayload_instant_ltc_trade', { params: [1, '1', '0.01', 200000, false, 0, 1] });
+    assert.equal(columnB.data.split(',')[2], '0');
+});
+
+test('native trade refuses the legacy four-argument call and any missing or conflicting field', async () => {
+    const { proxyWalletMethod } = proxy();
+    for (const params of [
+        [1, '1', '0.01', 200000], // legacy: no column or output indices
+        [1, '1', '0.01', 0, true, 0, 1], // no expiry
+        [1, '1', '0.01', 200000, true, 1, 1], // payment and delivery are the same output
+        [1, '1', '0.01', 200000, 'A', 0, 1], // column must be boolean-like
+        [1, '1', 0, 200000, true, 0, 1], // nothing paid
+        [1, 0, '0.01', 200000, true, 0, 1], // no tokens
+        [0, '1', '0.01', 200000, true, 0, 1], // no property
+        [1, '1', '0.01', 200000, true, -1, 1], // negative output index
+    ]) {
+        const res = await proxyWalletMethod('tl_createpayload_instant_ltc_trade', { params });
+        assert.ok(res.error && res.data === undefined, JSON.stringify(params));
+    }
+});
+
+test('other locally built payloads are returned in the same data envelope', async () => {
+    const { proxyWalletMethod } = proxy();
+    const res = await proxyWalletMethod('tl_createpayload_attestation', { params: [0, 1, 'addr', 'meta'] });
+    assert.deepEqual(res, { data: 'tl9,0,1,addr,meta' });
+});
+
+test('the candidate consensus decoder reads back exactly what the bridge built', { skip: !fs.existsSync(CANDIDATE) && 'candidate checkout not present' }, async () => {
+    const decoder = require(CANDIDATE);
+    const { proxyWalletMethod } = proxy();
+    const commit = (await proxyWalletMethod('tl_createpayload_commit_tochannel', { params: [1, '1', CHANNEL] })).data;
+    const c = decoder.decodeCommitToken(commit.slice(3));
+    assert.equal(c.propertyId, 1); assert.equal(c.amount, 1); assert.equal(c.ref, '0');
+    const trade = (await proxyWalletMethod('tl_createpayload_instant_ltc_trade', { params: [1, '1', '0.01', 200000, true, 0, 1] })).data;
+    const t = decoder.decodeTradeTokenForUTXO(trade.slice(3));
+    assert.equal(t.invalidEncoding, undefined);
+    assert.deepEqual({ propertyId: t.propertyId, amount: t.amount, columnA: t.columnA, satsExpected: t.satsExpected,
+        tokenOutput: t.tokenOutput, payToAddress: t.payToAddress, tagWithdraw: t.tagWithdraw, expiryBlock: t.expiryBlock },
+    { propertyId: 1, amount: 1, columnA: true, satsExpected: 1000000, tokenOutput: 0, payToAddress: 1, tagWithdraw: null, expiryBlock: 200000 });
+});
+
+test('swapper payload parameters name the trade transaction outputs the guard pins', () => {
+    const { tradePayloadParams, TRADE_TOKEN_OUTPUT, TRADE_PAYMENT_OUTPUT } = tradePayload();
+    assert.equal(TRADE_TOKEN_OUTPUT, 0); assert.equal(TRADE_PAYMENT_OUTPUT, 1);
+    assert.deepEqual(tradePayloadParams(1, 100000000, 1000000, 200000, false), [1, '1', '0.01', 200000, false, 0, 1]);
+});
+
+test('a listener without the expiry capability is refused before anything is committed or paid', async () => {
+    const { assertListenerSupportsTrade } = tradePayload();
+    await assertListenerSupportsTrade(async () => ({ data: CAPABILITIES }));
+    for (const reply of [
+        { error: 'Cannot POST /tl_getProtocolCapabilities' },
+        { data: {} },
+        { data: { ...CAPABILITIES, tradeTokenForUTXO: { maxParts: 8, expiryBlock: true } } },
+        { data: { ...CAPABILITIES, tradeTokenForUTXO: { maxParts: 9, expiryBlock: 'yes' } } },
+        { data: { ...CAPABILITIES, channelColumn: { version: 1 } } },
+    ]) {
+        await assert.rejects(assertListenerSupportsTrade(async () => reply), /does not enforce trade expiry/, JSON.stringify(reply));
+    }
+});
+
+test('the channel column comes from the listener and an inconsistent answer is refused', async () => {
+    const { sellerColumnA } = tradePayload();
+    const calls = [];
+    const client = async (method, params) => { calls.push([method, params]); return { data: { column: 'B', columnA: false } }; };
+    assert.equal(await sellerColumnA(client, 'channel', 'seller', 'buyer'), false);
+    assert.deepEqual(calls, [['tl_getChannelColumn', ['channel', 'seller', 'buyer']]]);
+    for (const reply of [{ data: 'A' }, { data: { column: 'A', columnA: false } }, { data: { column: 'C', columnA: false } }, { error: 'down' }]) {
+        await assert.rejects(sellerColumnA(async () => reply, 'channel', 'seller', 'buyer'), /tl_getChannelColumn/, JSON.stringify(reply));
+    }
+});
