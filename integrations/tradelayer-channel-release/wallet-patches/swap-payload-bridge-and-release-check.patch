+// What both sides put in the trade's TradeLayer payload besides the agreed amounts: the
+// channel column that holds the seller's tokens, the output indices, and the expiry block.
+// Buyer and seller each derive these and the seller compares the payload byte for byte.
+
+import { TClient } from './common';
+import { unitsToDecimal } from '../units';
+
+// Output layout of the trade transaction (wallet-server tx-builder.service.ts buildLTCInstatTx):
+// the buyer's change output receives the tokens, the seller's output is the payment, and the
+// OP_RETURN comes last. The payload commits to these indices; the PSBT guard pins the order.
+export const TRADE_TOKEN_OUTPUT = 0;
+export const TRADE_PAYMENT_OUTPUT = 1;
+
+// The payload carries the expiry as a ninth field. A listener without this capability does not
+// enforce it, so each side refuses before anything is committed, signed or paid.
+export const assertListenerSupportsTrade = async (client: TClient): Promise<void> => {
+    const res = await client('tl_getProtocolCapabilities', []);
+    const trade = res.data?.tradeTokenForUTXO;
+    const column = res.data?.channelColumn;
+    if (res.error || trade?.expiryBlock !== true || !(Number(trade?.maxParts) >= 9) || !(Number(column?.version) >= 2)) {
+        throw new Error(`listener does not enforce trade expiry: ${res.error || 'capability missing'}`);
+    }
+};
+
+// Column of the channel that holds the seller's committed tokens, as the listener's consensus
+// code assigns it from the channel record.
+export const sellerColumnA = async (client: TClient, channelAddress: string, sellerAddress: string, buyerAddress: string): Promise<boolean> => {
+    const res = await client('tl_getChannelColumn', [channelAddress, sellerAddress, buyerAddress]);
+    const column = res.data?.column;
+    if (res.error || (column !== 'A' && column !== 'B') || res.data?.columnA !== (column === 'A')) {
+        throw new Error(`tl_getChannelColumn: ${res.error || 'no column'}`);
+    }
+    return column === 'A';
+};
+
+// Positional parameters of tl_createpayload_instant_ltc_trade (rpc-proxy.service.ts).
+export const tradePayloadParams = (propId: number | string, amountDesired: number, amountForSale: number, expiry: number, columnA: boolean) =>
+    [propId, unitsToDecimal(amountDesired), unitsToDecimal(amountForSale), expiry, columnA, TRADE_TOKEN_OUTPUT, TRADE_PAYMENT_OUTPUT];
