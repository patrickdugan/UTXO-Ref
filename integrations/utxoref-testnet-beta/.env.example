# The Node service and Bitcoin Core RPC must stay on loopback.
BETA_BIND_HOST=127.0.0.1
PORT=8790
BETA_BASE_PATH=/utxoref-beta
BETA_PUBLIC_ORIGIN=https://beta.example.org
BETA_TRUST_PROXY=1
BETA_GUARDIAN_REGISTRY_PATH=/etc/utxoref-beta-guardians.json
BETA_GUARDIAN_RESERVE_PATH=/etc/utxoref-beta-guardian-reserve.json
BETA_REQUIRE_GUARDIAN_QUORUM=1
BETA_GUARDIAN_HEARTBEAT_MAX_AGE_SECONDS=180
BETA_GUARDIAN_CLOCK_SKEW_SECONDS=60

BTCTEST_DATADIR=/var/lib/bitcoin-testnet4
BTC_RPC_URL=http://127.0.0.1:48332
BTC_WALLET=utxoref-testnet
# Use a dedicated rpcauth user limited to the service's six methods, not the
# datadir cookie (which grants every method). In bitcoin.conf:
#   rpcauth=utxoref-beta:<salt>$<hash>        (share/rpcauth/rpcauth.py)
#   rpcwhitelist=utxoref-beta:getblockchaininfo,getbalances,validateaddress,sendtoaddress,gettxout,listtransactions
#   rpcwhitelistdefault=0
# The service refuses to start if the user can call a method outside that set.
BTC_RPC_USER=utxoref-beta
BTC_RPC_PASS=
# Cookie auth is refused unless explicitly allowed for a disposable local node.
# BETA_ALLOW_COOKIE_RPC=1

BETA_STATE_PATH=/var/lib/utxoref-beta/state.json
BETA_FAUCET_AMOUNT_SATS=1000
BETA_WALLET_RESERVE_FLOOR_SATS=250000
BETA_DAILY_BUDGET_SATS=50000
BETA_FEE_BUFFER_SATS=1000
BETA_IP_CLAIMS_PER_DAY=1
BETA_ADDRESS_CLAIMS_TOTAL=1
BETA_POSTS_PER_MINUTE=20
BETA_POSTS_PER_HOUR=100
BETA_MAX_STRESS_ITERATIONS=50
BETA_MAX_STRESS_RUNS_PER_INVITE=10
BETA_MAX_CONCURRENT_STRESS_RUNS=2
BETA_MAX_CHAIN_LAG_BLOCKS=12
BETA_STATUS_CACHE_MS=3000
