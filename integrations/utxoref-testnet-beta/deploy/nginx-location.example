# Place this inside an existing TLS server block. Keep the upstream loopback-only.
location = /utxoref-beta {
  return 308 /utxoref-beta/;
}

location /utxoref-beta/ {
  client_max_body_size 16k;
  client_body_timeout 10s;
  limit_req zone=utxoref_beta_read burst=20 nodelay;
  limit_req zone=utxoref_beta_mutation burst=3 nodelay;
  limit_conn utxoref_beta_connections 10;
  limit_except GET POST OPTIONS { deny all; }
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $remote_addr;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_connect_timeout 5s;
  proxy_read_timeout 180s;
  proxy_send_timeout 30s;
  proxy_request_buffering on;
  proxy_pass http://127.0.0.1:8793;
  add_header Strict-Transport-Security "max-age=31536000" always;
}
